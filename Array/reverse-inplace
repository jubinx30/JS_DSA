function rev(arr){
    mid = Math.floor(arr.length/2);
    if(arr.length%2==0)
    {
        for(i=0;i<mid;i++)
        {
        temp = arr[mid+i];
        arr[mid+i]=arr[mid-(i+1)];
        arr[mid-(i+1)] = temp;
        }
        return arr;
    }
    if(arr.length%2!==0)
    {
        for(i=0;i<mid;i++)
        {
            temp = arr[mid+(i+1)];
            arr[mid+(i+1)] = arr[mid-(i+1)];
            arr[mid-(i+1)] = temp;
        }
        return arr;
    }
}

